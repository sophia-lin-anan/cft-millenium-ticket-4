# Provider used by the analyst: mock, openai, or anthropic
ANALYST_PROVIDER=mock

# Required for OpenAI or Anthropic live runs.
ANALYST_MODEL=replace-with-model-id

# Keep real credentials in .env.local, never in this template.
OPENAI_API_KEY=replace-with-openai-api-key
ANTHROPIC_API_KEY=replace-with-anthropic-api-key
